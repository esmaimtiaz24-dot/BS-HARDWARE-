{
  "rules": {
    "products": { ".read": true, ".write": "auth != null", ".indexOn": ["createdAt", "category", "price"] },

    "orders": {
      ".indexOn": ["orderNumber", "createdAt", "status"],
      ".read": true,
      "$orderId": {
        ".write": "auth != null || !data.exists()",
        "status":  { ".validate": "newData.isString()" },
        "customer": {
          ".validate": "newData.hasChildren(['name', 'phone', 'address'])"
        }
      }
    },

    "expenses": { ".read": "auth != null", ".write": "auth != null", ".indexOn": ["date", "category"] },

    "$other": { ".read": false, ".write": false }
  }
}
